library(here)#
here::i_am(".here")#
cat("Project root is now:", here(), "\n")
install.packages("vegan")#
library(vegan)#
#
dist_matrix_obj <- dist(t(assay(vst_data)))#
#
batch_vec <- sample_table$batch[#
  match(colnames(vst_data), sample_table$sample_name)#
]#
diagnosis_vec <- sample_table$diagnosis[#
  match(colnames(vst_data), sample_table$sample_name)#
]#
#
set.seed(42)#
permanova_result <- adonis2(#
  dist_matrix_obj ~ batch_vec + diagnosis_vec,#
  permutations = 999#
)#
#
cat("=== PERMANOVA: variance explained ===\n")#
print(permanova_result)#
#
cat("\nBatch R2:    ", round(permanova_result$R2[1], 4), "\n")#
cat("Diagnosis R2:", round(permanova_result$R2[2], 4), "\n")
# Run separate models to get individual R2 values#
set.seed(42)#
permanova_batch <- adonis2(#
  dist_matrix_obj ~ batch_vec,#
  permutations = 999#
)#
#
set.seed(42)#
permanova_diagnosis <- adonis2(#
  dist_matrix_obj ~ diagnosis_vec,#
  permutations = 999#
)#
#
cat("=== Batch alone ===\n")#
cat("R2:", round(permanova_batch$R2[1], 4), "\n")#
cat("p-value:", permanova_batch$`Pr(>F)`[1], "\n")#
#
cat("\n=== Diagnosis alone ===\n")#
cat("R2:", round(permanova_diagnosis$R2[1], 4), "\n")#
cat("p-value:", permanova_diagnosis$`Pr(>F)`[1], "\n")#
#
# Also run adonis2 with by="terms" for sequential decomposition#
set.seed(42)#
permanova_terms <- adonis2(#
  dist_matrix_obj ~ batch_vec + diagnosis_vec,#
  permutations = 999,#
  by = "terms"#
)#
#
cat("\n=== Sequential decomposition by terms ===\n")#
print(permanova_terms)
