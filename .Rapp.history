    "Batch1" = "#1D9E75",#
    "Batch2" = "#D85A30"#
  )) +#
  labs(title = "PCA colored by sequencing batch",#
       subtitle = "Checking for batch-driven separation") +#
  theme_minimal(base_size = 12)#
#
ggsave(here("results/qc/PCA_batch_check.pdf"),#
       p_batch, width = 8, height = 6)#
#
print(p_batch)#
cat("\nBatch PCA saved.\n")
