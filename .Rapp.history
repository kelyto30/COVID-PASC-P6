library(tidyverse)#
#
# Build clean metadata for all 73 frontal cortex samples#
meta_clean <- meta %>%#
  filter(source_name_ch1 == "Frontal cortex of brain") %>%#
  select(#
    geo_accession,#
    age       = `age:ch1`,#
    group     = `group:ch1`,#
    sex       = `Sex:ch1`,#
    source    = source_name_ch1#
  ) %>%#
  mutate(#
    age           = as.numeric(age),#
    sex_male      = as.integer(sex == "M"),#
    age_group_60  = ifelse(age >= 60, ">=60", "<60"),#
    age_group_60  = factor(age_group_60, levels = c("<60", ">=60")),#
    diagnosis     = case_when(#
      group %in% c("COVID-19", "ICU/VENT") ~ "COVID19",#
      group == "Control"                   ~ "Control",#
      group == "Old"                       ~ "Old_Control",#
      group == "Young"                     ~ "Young_Control",#
      TRUE                                 ~ NA_character_#
    )#
  )#
#
cat("=== Clean metadata summary ===\n")#
cat("Total samples:", nrow(meta_clean), "\n\n")#
#
cat("Group breakdown:\n")#
print(table(meta_clean$group))#
#
cat("\nDiagnosis breakdown:\n")#
print(table(meta_clean$diagnosis))#
#
cat("\nAge group breakdown:\n")#
print(table(meta_clean$age_group_60, meta_clean$diagnosis))#
