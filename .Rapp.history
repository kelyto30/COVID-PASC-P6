control <- c(0.80, 1.15, 1.15, 1.75, 1.30)#
intranasal <- c(3.55, 2.75, 1.60, 3.50, 2.50)#
intravenous <- c(2.05, 2.40, 0.85, 1.75, 2.55)#
#
# Function to calculate Cohen's d effect size#
cohens_d <- function(group1, group2) {#
  mean_diff <- mean(group1) - mean(group2)#
  pooled_sd <- sqrt(((length(group1) - 1) * sd(group1)^2 + (length(group2) - 1) * sd(group2)^2) / (length(group1) + length(group2) - 2))#
  return(mean_diff / pooled_sd)#
}#
#
# Calculate effect sizes#
intranasal_vs_control_d <- cohens_d(intranasal, control)#
intravenous_vs_control_d <- cohens_d(intravenous, control)#
#
# Print the results#
cat("Effect size (Cohen's d) for Intranasal vs Control:", intranasal_vs_control_d, "\n")#
cat("Effect size (Cohen's d) for Intravenous vs Control:", intravenous_vs_control_d, "\n")
