# ---------- Packages ----------#
if (!requireNamespace("BiocManager", quietly = TRUE)) install.packages("BiocManager")#
pkgs <- c("tximport", "readr", "dplyr", "biomaRt")#
for (p in pkgs) {#
  if (!requireNamespace(p, quietly = TRUE)) BiocManager::install(p, ask = FALSE, update = FALSE)#
}#
#
library(tximport)#
library(readr)#
library(dplyr)#
library(biomaRt)#
#
# ---------- 1) Point to your folder ----------#
raw_dir <- "/Users/kelechielechi/Documents/THESIS SEARCH/LONG NON CODING COV 19/GSE188847_RAW"#
#
# ---------- 2) Collect ALL Salmon quant files (both naming styles) ----------#
files <- list.files(raw_dir, pattern = "\\.gz$", full.names = TRUE)#
#
cat("Total .gz files found:", length(files), "\n")#
stopifnot(length(files) == 94)#
#
# ---------- 3) Build sample table from filenames ----------#
# Examples:#
# GSM6793305_TNFA_LO_3.salmon.quant.sf.gz#
# GSM5690975_CONTROL12.salmon.sf.txt.gz#
#
sample_id <- basename(files) %>%#
  sub("\\.salmon\\.quant\\.sf\\.gz$", "", x = .) %>%#
  sub("\\.salmon\\.sf\\.txt\\.gz$", "", x = .)#
#
samples <- tibble(#
  sample_id = sample_id,#
  gsm = sub("_.*", "", sample_id),#
  label = sub("^GSM[0-9]+_", "", sample_id),#
  file = files#
)#
#
# Name the file vector with sample_id (tximport uses this as column names)#
files_named <- setNames(samples$file, samples$sample_id)#
#
print(head(samples, 12))#
#
# ---------- 4) Get tx2gene mapping from Ensembl (GRCh38) ----------#
# Your quant files use ENST IDs with versions like ENST....1#
# tximport can ignore transcript versions, but we'll also strip for safety.#
#
strip_version <- function(x) sub("\\.[0-9]+$", "", x)#
#
mart <- useEnsembl(biomart = "ensembl", dataset = "hsapiens_gene_ensembl")#
tx2gene <- getBM(#
  attributes = c("ensembl_transcript_id", "ensembl_gene_id"),#
  mart = mart#
) %>%#
  as_tibble() %>%#
  transmute(#
    tx = strip_version(ensembl_transcript_id),#
    gene = ensembl_gene_id#
  ) %>%#
  distinct()#
#
cat("tx2gene rows:", nrow(tx2gene), "\n")#
#
# ---------- 5) tximport -> gene-level counts + TPM ----------#
txi <- tximport(#
  files_named,#
  type = "salmon",#
  tx2gene = tx2gene,#
  ignoreTxVersion = TRUE#
)#
#
# ---------- 6) Save outputs ----------#
write.csv(txi$counts, file = file.path(raw_dir, "gene_counts_tximport.csv"))#
write.csv(txi$abundance, file = file.path(raw_dir, "gene_tpm_tximport.csv"))#
write.csv(samples, file = file.path(raw_dir, "sample_manifest_from_filenames.csv"), row.names = FALSE)#
#
cat("Saved in:", raw_dir, "\n",#
    "- gene_counts_tximport.csv\n",#
    "- gene_tpm_tximport.csv\n",#
    "- sample_manifest_from_filenames.csv\n")
>
