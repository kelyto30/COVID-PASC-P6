library(HGNChelper)#
#
# ── Step 1: Build Ensembl -> Symbol mapping from tx2gene ──#
cat("Building Ensembl to symbol mapping...\n")#
#
# tx2gene has transcript -> Ensembl gene ID#
# We need Ensembl gene ID -> HGNC symbol#
# Use biomaRt for this#
#
library(biomaRt)#
#
mart <- useMart("ensembl", dataset = "hsapiens_gene_ensembl")#
#
ensembl_ids <- rownames(dds_filtered)#
cat("Querying biomaRt for", length(ensembl_ids), "Ensembl IDs...\n")#
#
id_map <- getBM(#
  attributes = c("ensembl_gene_id", "hgnc_symbol"),#
  filters    = "ensembl_gene_id",#
  values     = ensembl_ids,#
  mart       = mart#
)#
#
cat("Mapped:", nrow(id_map), "entries\n")#
cat("Unique Ensembl IDs mapped:", length(unique(id_map$ensembl_gene_id)), "\n")#
cat("Unique symbols:", length(unique(id_map$hgnc_symbol)), "\n")#
cat("Empty symbols:", sum(id_map$hgnc_symbol == ""), "\n")#
#
# Preview#
cat("\nFirst 10 mappings:\n")#
print(head(id_map, 10))
# Install if needed#
if (!requireNamespace("org.Hs.eg.db", quietly = TRUE))#
  BiocManager::install("org.Hs.eg.db")#
#
library(org.Hs.eg.db)#
#
# ── Build Ensembl -> Symbol map offline ───────────────────#
cat("Building offline Ensembl -> Symbol mapping...\n")#
#
ensembl_ids <- rownames(dds_filtered)#
#
# Query org.Hs.eg.db#
id_map <- AnnotationDbi::select(#
  org.Hs.eg.db,#
  keys    = ensembl_ids,#
  columns = c("ENSEMBL", "SYMBOL"),#
  keytype = "ENSEMBL"#
)#
#
cat("Total mappings returned:", nrow(id_map), "\n")#
cat("Unique Ensembl IDs mapped:", #
    length(unique(id_map$ENSEMBL)), "\n")#
cat("Unique symbols:", #
    length(unique(id_map$SYMBOL[id_map$SYMBOL != ""])), "\n")#
cat("Unmapped (NA symbol):", #
    sum(is.na(id_map$SYMBOL)), "\n")#
#
cat("\nFirst 10 mappings:\n")#
print(head(id_map, 10))#
#
# Check our key SASP genes#
cat("\n=== Core SASP genes in mapping ===\n")#
sasp_core <- c("IL1B","IL6","TNF","MMP3","CXCL10",#
               "CXCL8","CCL2","CXCL1","GDF15","SERPINE1")#
print(id_map[id_map$SYMBOL %in% sasp_core, ])
# ── Clean the mapping: one symbol per Ensembl ID ──────────#
# Remove NAs, handle 1:many by keeping first symbol per ID#
id_map_clean <- id_map %>%#
  filter(!is.na(SYMBOL), SYMBOL != "") %>%#
  dplyr::group_by(ENSEMBL) %>%#
  dplyr::slice(1) %>%          # keep first symbol if multiple#
  ungroup()#
#
cat("Clean mapping entries:", nrow(id_map_clean), "\n")#
#
# ── Rename dds_filtered rows to gene symbols ───────────────#
# Match Ensembl IDs in dds to our mapping#
matched_idx <- match(rownames(dds_filtered), id_map_clean$ENSEMBL)#
has_symbol  <- !is.na(matched_idx)#
#
cat("Genes with symbol:", sum(has_symbol), "\n")#
cat("Genes without symbol (kept as Ensembl):", sum(!has_symbol), "\n")#
#
# Create new row names#
new_names <- rownames(dds_filtered)#
new_names[has_symbol] <- id_map_clean$SYMBOL[matched_idx[has_symbol]]#
#
# Check for duplicates before assigning#
cat("Duplicate symbols:", sum(duplicated(new_names)), "\n")#
#
# Make unique (add .1 .2 suffix to duplicates)#
new_names_unique <- make.unique(new_names, sep = ".")#
#
# Apply to dds#
dds_symbol <- dds_filtered#
rownames(dds_symbol) <- new_names_unique#
#
# Also update VST object#
rownames(vst_data) <- new_names_unique#
#
cat("\nFirst 10 row names after conversion:\n")#
print(head(rownames(dds_symbol), 10))#
#
# ── Re-check coverage ─────────────────────────────────────#
expressed_symbols <- rownames(dds_symbol)#
#
cat("\n=== Coverage AFTER symbol conversion ===\n")#
cat("SenMayo in dataset: ",#
    sum(senmayo_genes %in% expressed_symbols),#
    "/", length(senmayo_genes), "\n")#
cat("CellAge in dataset: ",#
    sum(cellage_genes %in% expressed_symbols),#
    "/", length(cellage_genes), "\n")#
cat("GenAge in dataset:  ",#
    sum(genage_genes %in% expressed_symbols),#
    "/", length(genage_genes), "\n")#
#
cat("\n=== Core SASP genes after conversion ===\n")#
for (g in sasp_core) {#
  cat(g, ":", ifelse(g %in% expressed_symbols,#
                      "PRESENT", "MISSING"), "\n")#
}#
#
# Save updated objects#
saveRDS(dds_symbol, here("data/processed/dds_symbol.rds"))#
saveRDS(id_map_clean, here("data/processed/ensembl_to_symbol.rds"))#
cat("\nObjects saved.\n")
library(GSVA)#
#
# ── Build gene set list ───────────────────────────────────#
gene_sets <- list(#
  SenMayo = senmayo_genes[senmayo_genes %in% expressed_symbols],#
  CellAge = cellage_genes[cellage_genes %in% expressed_symbols],#
  GenAge  = genage_genes[genage_genes  %in% expressed_symbols]#
)#
#
cat("=== Gene sets for ssGSEA ===\n")#
cat("SenMayo:", length(gene_sets$SenMayo), "genes\n")#
cat("CellAge:", length(gene_sets$CellAge), "genes\n")#
cat("GenAge: ", length(gene_sets$GenAge),  "genes\n")#
#
# ── Extract log2-CPM matrix from VST ─────────────────────#
expr_mat <- assay(vst_data)#
cat("\nExpression matrix:", dim(expr_mat), "\n")#
#
# ── Run ssGSEA ────────────────────────────────────────────#
cat("\nRunning ssGSEA (this takes 2-5 minutes)...\n")#
#
gsva_param <- gsvaParam(#
  exprData = expr_mat,#
  geneSets = gene_sets,#
  kcdf     = "Gaussian",    # for VST/log-transformed data#
  minSize  = 10,#
  maxSize  = 1000#
)#
#
set.seed(42)#
sen_scores <- gsva(gsva_param, verbose = TRUE)#
#
cat("\nssGSEA complete.\n")#
cat("Score matrix dimensions:", dim(sen_scores), "\n")#
cat("Rows (signatures):", rownames(sen_scores), "\n")#
cat("Columns (samples):", ncol(sen_scores), "\n")#
#
# ── Preview scores ────────────────────────────────────────#
cat("\nRaw score ranges:\n")#
for (sig in rownames(sen_scores)) {#
  cat(sig, ": min=", round(min(sen_scores[sig,]), 3),#
      " max=", round(max(sen_scores[sig,]), 3),#
      " mean=", round(mean(sen_scores[sig,]), 3), "\n")#
}
library(ggplot2)#
library(tidyverse)#
library(here)#
#
# ── Build scored dataset ───────────────────────────────────#
scores_df <- as.data.frame(t(sen_scores)) %>%#
  rownames_to_column("sample_name") %>%#
  left_join(sample_table, by = "sample_name")#
#
cat("Scored samples:", nrow(scores_df), "\n")#
#
# ── Z-score normalize ──────────────────────────────────────#
scores_df <- scores_df %>%#
  mutate(#
    SenMayo_z = scale(SenMayo)[,1],#
    CellAge_z = scale(CellAge)[,1],#
    GenAge_z  = scale(GenAge)[,1]#
  )#
#
# ── Summary by diagnosis ───────────────────────────────────#
cat("\n=== Mean senescence scores by diagnosis ===\n")#
scores_df %>%#
  group_by(diagnosis) %>%#
  summarise(#
    n         = n(),#
    SenMayo_z = round(mean(SenMayo_z), 3),#
    CellAge_z = round(mean(CellAge_z), 3),#
    GenAge_z  = round(mean(GenAge_z),  3),#
    mean_age  = round(mean(age), 1)#
  ) %>% print()#
#
# ── COVID19 by age group ───────────────────────────────────#
cat("\n=== COVID19 only: by age group ===\n")#
scores_df %>%#
  filter(diagnosis == "COVID19") %>%#
  group_by(age_group_60) %>%#
  summarise(#
    n         = n(),#
    SenMayo_z = round(mean(SenMayo_z), 3),#
    CellAge_z = round(mean(CellAge_z), 3),#
    GenAge_z  = round(mean(GenAge_z),  3),#
    mean_age  = round(mean(age), 1)#
  ) %>% print()#
#
# ── Violin plot ────────────────────────────────────────────#
scores_long <- scores_df %>%#
  pivot_longer(#
    cols      = c(SenMayo_z, CellAge_z, GenAge_z),#
    names_to  = "signature",#
    values_to = "score"#
  ) %>%#
  mutate(#
    signature = gsub("_z", "", signature),#
    diagnosis = factor(diagnosis,#
                       levels = c("Young_Control", "Control",#
                                  "COVID19", "Old_Control"))#
  )#
#
p_violin <- ggplot(scores_long,#
                   aes(x = diagnosis, y = score,#
                       fill = diagnosis)) +#
  geom_violin(alpha = 0.7, trim = TRUE) +#
  geom_jitter(width = 0.15, size = 1.5,#
              alpha = 0.6, color = "black") +#
  geom_boxplot(width = 0.12, fill = "white",#
               alpha = 0.8, outlier.shape = NA) +#
  facet_wrap(~ signature, ncol = 3) +#
  scale_fill_manual(values = c(#
    "Young_Control" = "#1D9E75",#
    "Control"       = "#888780",#
    "COVID19"       = "#D85A30",#
    "Old_Control"   = "#7F77DD"#
  )) +#
  labs(#
    x        = NULL,#
    y        = "Senescence score (z-normalized)",#
    title    = "Brain senescence burden by diagnosis",#
    subtitle = "GSE188847 frontal cortex (n=73)"#
  ) +#
  theme_minimal(base_size = 11) +#
  theme(#
    legend.position = "none",#
    axis.text.x     = element_text(angle = 30, hjust = 1),#
    strip.text      = element_text(face = "bold")#
  )#
#
ggsave(here("results/figures/Fig1_senescence_by_diagnosis.pdf"),#
       p_violin, width = 10, height = 5)#
print(p_violin)#
#
write.csv(scores_df,#
          here("results/tables/senescence_scores.csv"),#
          row.names = FALSE)#
#
cat("\nFigure and scores saved.\n")
# ── Save Fig1 as PNG ───────────────────────────────────────#
ggsave(#
  here("results/figures/Fig1_senescence_by_diagnosis.png"),#
  p_violin,#
  width  = 10,#
  height = 5,#
  dpi    = 300,#
  bg     = "white"#
)#
#
cat("PNG saved to:\n")#
cat(here("results/figures/Fig1_senescence_by_diagnosis.png"), "\n")
library(lme4)#
library(lmerTest)#
#
# ── LME model for each signature ──────────────────────────#
# Pre-specified model (SAP): #
# SenES ~ age_group_60 * diagnosis + sex_male + (1|batch)#
#
# First set reference levels#
scores_df$diagnosis   <- factor(scores_df$diagnosis,#
                                 levels = c("Control", "COVID19",#
                                            "Old_Control",#
                                            "Young_Control"))#
scores_df$age_group_60 <- factor(scores_df$age_group_60,#
                                  levels = c("<60", ">=60"))#
#
results_list <- list()#
#
for (sig in c("SenMayo_z", "CellAge_z", "GenAge_z")) {#
  cat(sprintf("\n=== LME model: %s ===\n", sig))#
  formula <- as.formula(#
    paste0(sig, " ~ age_group_60 * diagnosis + sex_male + (1|batch)")#
  )#
  fit <- lmer(formula, data = scores_df, REML = FALSE)#
  fit_sum <- summary(fit)#
  coef_df <- as.data.frame(coef(fit_sum)) %>%#
    rownames_to_column("term") %>%#
    mutate(#
      signature = sig,#
      p_adj     = p.adjust(`Pr(>|t|)`, method = "BH")#
    )#
  results_list[[sig]] <- coef_df#
  # Print key terms#
  key_terms <- coef_df %>%#
    filter(grepl("COVID19|age_group", term))#
  print(key_terms %>% #
          select(term, Estimate, `Std. Error`, #
                 `t value`, `Pr(>|t|)`, p_adj) %>%#
          mutate(across(where(is.numeric), ~round(., 4))))#
}#
#
# Combine all results#
all_results <- bind_rows(results_list)#
#
write.csv(all_results,#
          here("results/tables/LME_senescence_results.csv"),#
          row.names = FALSE)#
#
cat("\nLME results saved.\n")
