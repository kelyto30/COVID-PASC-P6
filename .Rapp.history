  "/Users/kelechielechi/Documents/covid-brain-aging-thesis/data/processed/GSE188847/tx2gene.csv"#
)#
head(tx2gene)#
dim(tx2gene)
library(tximport)#
#
# Build tx2gene in correct format (transcript -> gene symbol)#
tx2gene_clean <- tx2gene %>%#
  mutate(tx_id = gsub("\\..*", "", ensembl_transcript_id_version)) %>%#
  dplyr::select(tx_id, gene_symbol = external_gene_name)#
#
head(tx2gene_clean)
library(tidyverse)
tx2gene_clean <- tx2gene %>%#
  mutate(tx_id = gsub("\\..*", "", ensembl_transcript_id_version)) %>%#
  dplyr::select(tx_id, gene_symbol = external_gene_name)#
#
head(tx2gene_clean)
salmon_dir <- "/Users/kelechielechi/Documents/GSE188847"#
#
all_files <- list.files(#
  salmon_dir,#
  pattern = "\\.sf\\.gz$|\\.sf\\.txt\\.gz$",#
  full.names = TRUE#
)#
#
sample_names <- gsub(".*_(.*)\\.salmon.*", "\\1", basename(all_files))#
names(all_files) <- sample_names#
#
cat("Total samples found:", length(all_files), "\n")#
print(sample_names)
# Fix sample names using a better extraction pattern#
sample_names_fixed <- basename(all_files) %>%#
  gsub("GSM[0-9]+_", "", .) %>%       # remove GSM ID#
  gsub("\\.salmon.*", "", .) %>%       # remove .salmon extension#
  gsub("\\.quant.*", "", .) %>%        # remove .quant extension#
  gsub("\\.sf.*", "", .)               # remove .sf extension#
#
names(all_files) <- sample_names_fixed#
print(sample_names_fixed)
# Build metadata for all 94 samples#
metadata_all <- data.frame(#
  sample_id = sample_names_fixed,#
  group = case_when(#
    grepl("^COVID",    sample_names_fixed) ~ "COVID",#
    grepl("^CONTROL|^CTRL", sample_names_fixed) ~ "Control",#
    grepl("^ICUVENT",  sample_names_fixed) ~ "ICU_VENT",#
    grepl("^O",        sample_names_fixed) ~ "Older_Adult",#
    grepl("^Y",        sample_names_fixed) ~ "Younger_Adult",#
    grepl("^IFNB_HI",  sample_names_fixed) ~ "IFNB_High",#
    grepl("^IFNB_LO",  sample_names_fixed) ~ "IFNB_Low",#
    grepl("^IFNG_HI",  sample_names_fixed) ~ "IFNG_High",#
    grepl("^IFNG_LO",  sample_names_fixed) ~ "IFNG_Low",#
    grepl("^TNFA_HI",  sample_names_fixed) ~ "TNFA_High",#
    grepl("^TNFA_LO",  sample_names_fixed) ~ "TNFA_Low"#
  ),#
  stringsAsFactors = FALSE#
)#
#
rownames(metadata_all) <- metadata_all$sample_id#
table(metadata_all$group)
txi <- tximport(#
  all_files,#
  type                = "salmon",#
  tx2gene             = tx2gene_clean,#
  txIn                = TRUE,#
  txOut               = FALSE,#
  ignoreTxVersion     = TRUE,#
  countsFromAbundance = "lengthScaledTPM"#
)#
#
cat("✅ tximport complete!\n")#
cat("Genes:", nrow(txi$counts), "\n")#
cat("Samples:", ncol(txi$counts), "\n")
# Save the txi object#
dir.create("/Users/kelechielechi/Documents/SAND_MR_Pipeline/SAND_MR_Pipeline/data", #
           recursive = TRUE, showWarnings = FALSE)#
#
saveRDS(txi, "/Users/kelechielechi/Documents/SAND_MR_Pipeline/SAND_MR_Pipeline/data/txi_all94.rds")#
saveRDS(metadata_all, "/Users/kelechielechi/Documents/SAND_MR_Pipeline/SAND_MR_Pipeline/data/metadata_all94.rds")#
#
cat("✅ Data saved!\n")
# Build DESeq2 object — focus on COVID vs Control for SAND hypothesis#
library(DESeq2)#
#
# Subset to COVID + Control only first#
keep_samples <- metadata_all$group %in% c("COVID", "Control")#
metadata_sand <- metadata_all[keep_samples, ]#
metadata_sand$group <- factor(metadata_sand$group, levels = c("Control", "COVID"))#
#
dds_sand <- DESeqDataSetFromTximport(#
  txi    = list(#
    counts    = txi$counts[,    keep_samples],#
    abundance = txi$abundance[, keep_samples],#
    length    = txi$length[,    keep_samples]#
  ),#
  colData = metadata_sand,#
  design  = ~ group#
)#
#
# Filter low count genes#
dds_sand <- dds_sand[rowSums(counts(dds_sand) >= 10) >= 3, ]#
cat("Genes after filtering:", nrow(dds_sand), "\n")
# Subset txi correctly by keeping the full object structure#
txi_sand <- txi#
txi_sand$counts    <- txi$counts[,    keep_samples]#
txi_sand$abundance <- txi$abundance[, keep_samples]#
txi_sand$length    <- txi$length[,    keep_samples]#
#
# Now build DESeq2 object#
dds_sand <- DESeqDataSetFromTximport(#
  txi     = txi_sand,#
  colData = metadata_sand,#
  design  = ~ group#
)#
#
# Filter low count genes#
dds_sand <- dds_sand[rowSums(counts(dds_sand) >= 10) >= 3, ]#
cat("Genes after filtering:", nrow(dds_sand), "\n")
# Run DESeq2#
dds_sand$group <- relevel(dds_sand$group, ref = "Control")#
dds_sand <- DESeq(dds_sand)#
cat("✅ DESeq2 complete!\n")
# Extract results#
res <- results(dds_sand,#
               contrast       = c("group", "COVID", "Control"),#
               alpha          = 0.05,#
               pAdjustMethod  = "BH")#
#
# Shrink fold changes#
res_shrunk <- lfcShrink(dds_sand,#
                        coef = "group_COVID_vs_Control",#
                        type = "apeglm",#
                        quiet = TRUE)#
#
# Quick summary#
summary(res_shrunk)
# Check your SAND signature genes specifically#
sand_genes <- c("IFITM1","IFITM2","IFITM3","OAS2","MX1",#
                "MX2","IRF1","IRF7","STAT2","ISG20","PSMB8")#
#
as.data.frame(res_shrunk) %>%#
  rownames_to_column("gene") %>%#
  filter(gene %in% sand_genes) %>%#
  arrange(padj)
# Save results first#
saveRDS(dds_sand,   "/Users/kelechielechi/Documents/SAND_MR_Pipeline/SAND_MR_Pipeline/data/dds_sand.rds")#
saveRDS(res_shrunk, "/Users/kelechielechi/Documents/SAND_MR_Pipeline/SAND_MR_Pipeline/data/res_shrunk_COVID_vs_Control.rds")#
#
de_df <- as.data.frame(res_shrunk) %>%#
  rownames_to_column("gene") %>%#
  mutate(#
    Significant = !is.na(padj) & padj < 0.05 & abs(log2FoldChange) > 0.5,#
    Direction   = ifelse(log2FoldChange > 0, "Up", "Down"),#
    SAND_gene   = gene %in% sand_genes#
  )#
#
write.csv(de_df,#
  "/Users/kelechielechi/Documents/SAND_MR_Pipeline/SAND_MR_Pipeline/data/DEG_COVID_vs_Control.csv",#
  row.names = FALSE)#
#
cat("✅ Results saved!\n")#
cat("Significant DEGs (FDR<0.05, |LFC|>0.5):", sum(de_df$Significant, na.rm=TRUE), "\n")#
cat("SAND genes significant:", sum(de_df$Significant & de_df$SAND_gene, na.rm=TRUE), "/", length(sand_genes), "\n")
library(ggrepel)#
#
# Prepare plot data#
plot_df <- de_df %>%#
  mutate(#
    neg_log10_p = -log10(pvalue),#
    color_group = case_when(#
      SAND_gene & Significant          ~ "SAND Signature (Sig)",#
      SAND_gene & !Significant         ~ "SAND Signature (NS)",#
      Significant & Direction == "Up"  ~ "Upregulated",#
      Significant & Direction == "Down"~ "Downregulated",#
      TRUE                             ~ "Not Significant"#
    ),#
    label = ifelse(SAND_gene, gene, NA)#
  )#
#
# Plot#
volcano <- ggplot(plot_df,#
    aes(x = log2FoldChange, y = neg_log10_p,#
        color = color_group)) +#
  geom_point(size = 1.2, alpha = 0.6) +#
  geom_point(#
    data = filter(plot_df, SAND_gene),#
    size = 3.5, alpha = 1#
  ) +#
  geom_label_repel(#
    aes(label = label),#
    size          = 3.5,#
    fontface      = "bold",#
    box.padding   = 0.5,#
    max.overlaps  = 20,#
    show.legend   = FALSE,#
    segment.color = "gray40"#
  ) +#
  geom_vline(xintercept = c(-0.5, 0.5),#
             linetype = "dashed", color = "gray50") +#
  geom_hline(yintercept = -log10(0.05),#
             linetype = "dashed", color = "gray50") +#
  scale_color_manual(values = c(#
    "SAND Signature (Sig)" = "#9B2226",#
    "SAND Signature (NS)"  = "#EE9B00",#
    "Upregulated"          = "#AE2012",#
    "Downregulated"        = "#005F73",#
    "Not Significant"      = "gray75"#
  )) +#
  labs(#
    title    = "COVID-19 vs. Control — Post-mortem Brain",#
    subtitle = "SAND IFN-I signature genes highlighted (de Erausquin et al., 2022)",#
    x        = "log2 Fold Change (COVID / Control)",#
    y        = "-log10(p-value)",#
    color    = NULL,#
    caption  = "9/11 SAND signature genes significantly upregulated (FDR<0.05, |LFC|>0.5)"#
  ) +#
  theme_classic(base_size = 13) +#
  theme(#
    plot.title    = element_text(face = "bold", size = 13),#
    plot.subtitle = element_text(color = "gray40", size = 10),#
    plot.caption  = element_text(color = "gray40", size = 9),#
    legend.position = "bottom"#
  )#
#
# Save#
ggsave(#
  "/Users/kelechielechi/Documents/SAND_MR_Pipeline/SAND_MR_Pipeline/data/Volcano_SAND_COVID_vs_Control.png",#
  volcano, width = 10, height = 8, dpi = 300#
)#
#
cat("✅ Volcano plot saved!\n")#
print(volcano)
library(pheatmap)#
#
# Get VST normalized counts#
vst_sand <- assay(vst(dds_sand, blind = FALSE))#
#
# Extract just SAND genes#
