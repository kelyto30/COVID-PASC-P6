cat("\nDiagnosis breakdown:\n")#
print(table(sample_table$diagnosis))#
#
cat("\nAge group breakdown:\n")#
print(table(sample_table$age_group_60, sample_table$diagnosis))#
#
# ── Step 2: Filter count matrix to these 73 samples ───────#
keep_samples  <- sample_table$sample_name#
counts_fc     <- txi$counts[, keep_samples]#
abundance_fc  <- txi$abundance[, keep_samples]#
length_fc     <- txi$length[, keep_samples]#
#
cat("\nFiltered count matrix dimensions:", dim(counts_fc), "\n")#
#
# ── Step 3: Build txi subset for DESeq2 ───────────────────#
txi_fc <- list(#
  counts    = counts_fc,#
  abundance = abundance_fc,#
  length    = length_fc,#
  countsFromAbundance = txi$countsFromAbundance#
)#
#
# ── Step 4: Build DESeq2 object ───────────────────────────#
# Ensure sample table row order matches count matrix columns#
sample_table <- sample_table[match(colnames(txi_fc$counts), #
                                    sample_table$sample_name), ]#
rownames(sample_table) <- sample_table$sample_name#
#
dds <- DESeqDataSetFromTximport(#
  txi      = txi_fc,#
  colData  = sample_table,#
  design   = ~ diagnosis#
)#
#
cat("\nDESeq2 object created.\n")#
cat("Dimensions:", dim(dds), "\n")#
cat("Design:", as.character(design(dds)), "\n")#
#
# ── Step 5: Save objects ───────────────────────────────────#
saveRDS(dds,          here("data/processed/dds_raw.rds"))#
saveRDS(sample_table, here("data/processed/sample_table.rds"))#
saveRDS(txi_fc,       here("data/processed/txi_fc.rds"))#
#
cat("\nAll objects saved to data/processed/\n")
library(edgeR)#
library(ggplot2)#
library(here)#
#
# ── Step 1: Filter low-count genes ────────────────────────#
cat("Genes before filtering:", nrow(dds), "\n")#
#
keep <- filterByExpr(counts(dds), #
                     group = dds$diagnosis,#
                     min.count = 10,#
                     min.prop  = 0.2)#
#
dds_filtered <- dds[keep, ]#
cat("Genes after filtering:", nrow(dds_filtered), "\n")#
cat("Genes removed:", nrow(dds) - nrow(dds_filtered), "\n")#
#
# ── Step 2: Variance stabilizing transformation for QC ────#
cat("\nRunning VST normalization...\n")#
vst_data <- vst(dds_filtered, blind = TRUE)#
cat("VST complete.\n")#
#
# ── Step 3: PCA ───────────────────────────────────────────#
pca_data <- plotPCA(vst_data, #
                    intgroup = c("diagnosis", "age_group_60"),#
                    returnData = TRUE)#
#
percent_var <- round(100 * attr(pca_data, "percentVar"))#
#
p_pca <- ggplot(pca_data, #
                aes(x = PC1, y = PC2, #
                    color = diagnosis, #
                    shape = age_group_60)) +#
  geom_point(size = 3, alpha = 0.85) +#
  scale_color_manual(values = c(#
    "COVID19"       = "#D85A30",#
    "Control"       = "#5F5E5A",#
    "Old_Control"   = "#7F77DD",#
    "Young_Control" = "#1D9E75"#
  )) +#
  labs(#
    x       = paste0("PC1 (", percent_var[1], "% variance)"),#
    y       = paste0("PC2 (", percent_var[2], "% variance)"),#
    title   = "PCA — GSE188847 frontal cortex (73 samples)",#
    subtitle = "Shape = age group | Color = diagnosis",#
    color   = "Diagnosis",#
    shape   = "Age group"#
  ) +#
  theme_minimal(base_size = 12) +#
  theme(legend.position = "right")#
#
ggsave(here("results/qc/PCA_all_samples.pdf"), #
       p_pca, width = 8, height = 6)#
#
print(p_pca)#
#
cat("\nPCA plot saved to results/qc/PCA_all_samples.pdf\n")#
cat("\nPC1 vs PC2 variance explained:", percent_var[1], "%,", #
    percent_var[2], "%\n")#
#
# ── Step 4: Check for outliers ────────────────────────────#
cat("\nSample distances (to spot outliers):\n")#
sample_dists <- dist(t(assay(vst_data)))#
dist_matrix  <- as.matrix(sample_dists)#
mean_dist    <- rowMeans(dist_matrix)#
#
cat("Samples with unusually high mean distance (potential outliers):\n")#
threshold <- mean(mean_dist) + 2 * sd(mean_dist)#
outliers  <- names(mean_dist[mean_dist > threshold])#
if (length(outliers) == 0) {#
  cat("None detected — all samples look good.\n")#
} else {#
  cat("Flagged:", paste(outliers, collapse = ", "), "\n")#
}
cat("=== Investigating flagged samples ===\n")#
#
flagged <- c("COVID11", "COVID14", "COVID15")#
#
print(sample_table[sample_table$sample_name %in% flagged,#
                   c("sample_name", "geo_accession", #
                     "age", "sex", "diagnosis", #
                     "age_group_60", "group")])#
#
cat("\n=== Compare to rest of COVID19 group ===\n")#
covid_samples <- sample_table[sample_table$diagnosis == "COVID19", #
                               c("sample_name", "age", "sex", "group")]#
print(covid_samples)#
#
cat("\n=== Mean distances for flagged vs others ===\n")#
cat("Flagged sample distances:\n")#
print(round(mean_dist[flagged], 2))#
#
cat("\nOverall mean distance:", round(mean(mean_dist), 2), "\n")#
cat("Threshold used:", round(threshold, 2), "\n")
# ── Check batch effect: original vs added samples ─────────#
sample_table <- sample_table %>%#
  mutate(batch = ifelse(#
    grepl("^GSM5690", geo_accession), "Batch1", "Batch2"#
  ))#
#
cat("=== Batch breakdown ===\n")#
print(table(sample_table$batch, sample_table$diagnosis))#
#
cat("\n=== Flagged samples batch ===\n")#
print(sample_table[sample_table$sample_name %in% flagged,#
                   c("sample_name", "age", "geo_accession", "batch")])#
#
# PCA colored by batch to visualize batch effect#
pca_batch <- plotPCA(vst_data,#
                     intgroup = "batch",#
                     returnData = TRUE)#
#
# Add batch to vst colData for plotting#
vst_data$batch <- sample_table$batch[#
  match(colnames(vst_data), sample_table$sample_name)#
]#
#
pca_batch_data <- plotPCA(vst_data,#
                           intgroup = c("batch", "diagnosis"),#
                           returnData = TRUE)#
#
